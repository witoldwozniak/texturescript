# Self-contained authored example; paths are relative to this file.
# corn growth stages, derived from the polished mature plant
palette corn.palette
grid lower mature/lower.grid
grid upper mature/upper.grid
stages 8
shift 0 +2
shift 1 +2
shift 2 +1
shift 3 +1
map lower
